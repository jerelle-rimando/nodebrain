{
    "compilerOptions": {
      "target": "ES2020",
      "module": "Node16",
      "lib": ["ES2020"],
      "outDir": "./dist",
      "rootDir": ".",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "sourceMap": true,
      "moduleResolution": "Node16",
    },
    "include": ["./**/*.ts"],
    "exclude": ["node_modules", "dist", "wizard"]
  }